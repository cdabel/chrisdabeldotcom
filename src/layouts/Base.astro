---
// Latin subsets only, served from this origin with hashed names. Declared
// here rather than via fontsource's CSS so font-display can be `block`:
// text is held invisible until the font arrives (fast, since the files
// are preloaded with the HTML and total about 70 KB) and then painted once
// in the right face. Never a fallback on first visit, never a swap after.
// `optional` was tried first and showed fallback type on a cold first load.
import youngSerif from '@fontsource/young-serif/files/young-serif-latin-400-normal.woff2?url';
import plex400 from '@fontsource/ibm-plex-sans/files/ibm-plex-sans-latin-400-normal.woff2?url';
import plex400i from '@fontsource/ibm-plex-sans/files/ibm-plex-sans-latin-400-italic.woff2?url';
import plex500 from '@fontsource/ibm-plex-sans/files/ibm-plex-sans-latin-500-normal.woff2?url';
import plex600 from '@fontsource/ibm-plex-sans/files/ibm-plex-sans-latin-600-normal.woff2?url';

const face = (family: string, url: string, weight: number, style = 'normal') =>
  `@font-face{font-family:'${family}';font-style:${style};font-weight:${weight};font-display:block;src:url(${url}) format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}`;
const fontCss = [
  face('Young Serif', youngSerif, 400),
  face('IBM Plex Sans', plex400, 400),
  face('IBM Plex Sans', plex400i, 400, 'italic'),
  face('IBM Plex Sans', plex500, 500),
  face('IBM Plex Sans', plex600, 600),
].join('');
const preload = [youngSerif, plex400, plex500, plex600];

interface Props {
  title: string;
  description?: string;
}
const {
  title,
  description = 'Data engineer and architect. I build the data layer AI runs on, and I build with AI while I do it.',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);
const ogTitle = title.replace(/ \| Chris Dabel$/, '');
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    {preload.map((href) => (
      <link rel="preload" as="font" type="font/woff2" href={href} crossorigin />
    ))}
    <style set:html={fontCss}></style>
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="32x32" href="/icon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonical} />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Chris Dabel" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Chris Dabel. Data engineer and architect." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script is:inline>
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {}
    </script>
    <title>{title}</title>
  </head>
  <body>
    <header class="site">
      <nav>
        <a href="/">Chris Dabel</a>
        <a href="/cv/">CV</a>
        <a href="/work/">Work</a>
        <button id="theme-toggle" type="button" hidden aria-pressed="false">Dark mode</button>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <script>
      const root = document.documentElement;
      const button = document.getElementById('theme-toggle') as HTMLButtonElement;
      const media = window.matchMedia('(prefers-color-scheme: dark)');

      const current = (): 'light' | 'dark' =>
        root.dataset.theme === 'dark' || (!root.dataset.theme && media.matches) ? 'dark' : 'light';

      const label = () => {
        const dark = current() === 'dark';
        button.textContent = dark ? 'Light mode' : 'Dark mode';
        button.setAttribute('aria-pressed', String(dark));
      };

      button.addEventListener('click', () => {
        const next = current() === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try { localStorage.setItem('theme', next); } catch {}
        label();
      });

      media.addEventListener('change', label);
      label();
      button.hidden = false;
    </script>
  </body>
</html>

<style is:global>
  :root {
    --bg: #f5f6f8;
    --fg: #1b2430;
    --muted: #5b6470;
    --rule: #d9dde3;
    --accent: #1f6f78;
    --display: 'Young Serif', Georgia, serif;
    --text: 'IBM Plex Sans', system-ui, sans-serif;
    --measure: 40rem;
    color-scheme: light;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) {
      --bg: #15191f;
      --fg: #e6e8eb;
      --muted: #98a1ab;
      --rule: #2a3038;
      --accent: #7fcbd1;
      color-scheme: dark;
    }
  }
  :root[data-theme='dark'] {
    --bg: #15191f;
    --fg: #e6e8eb;
    --muted: #98a1ab;
    --rule: #2a3038;
    --accent: #7fcbd1;
    color-scheme: dark;
  }

  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--fg);
    font-family: var(--text);
    font-size: 1.0625rem;
    line-height: 1.6;
    font-feature-settings: 'kern', 'liga';
  }

  header.site, main {
    max-width: var(--measure);
    margin: 0 auto;
    padding: 0 1.25rem;
  }
  header.site nav {
    display: flex;
    gap: 1.5rem;
    padding: 1.75rem 0 0;
    font-weight: 500;
    font-size: 0.95rem;
  }
  header.site nav a { color: var(--muted); text-decoration: none; }
  header.site nav a:hover { color: var(--fg); }
  #theme-toggle {
    margin-left: auto;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    color: var(--muted);
    cursor: pointer;
  }
  #theme-toggle:hover { color: var(--fg); }
  main { padding: 3.5rem 1.25rem 5rem; }

  h1 {
    font-family: var(--display);
    font-weight: 400;
    font-size: clamp(2.5rem, 1.5rem + 4vw, 3.75rem);
    line-height: 1.02;
    letter-spacing: -0.015em;
    margin: 0 0 1.25rem;
  }
  h2 {
    font-size: 1.125rem;
    font-weight: 600;
    margin: 3.5rem 0 1rem;
  }
  h3 { font-size: 1.125rem; font-weight: 600; margin: 0; }
  p { margin: 0 0 1.1rem; max-width: var(--measure); }

  a { color: var(--accent); text-decoration-thickness: 1px; text-underline-offset: 0.15em; }
  a:hover { text-decoration-thickness: 2px; }
  :focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; border-radius: 2px; }

  ::selection { background: var(--accent); color: var(--bg); }
</style>
