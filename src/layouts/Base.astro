---
import '@fontsource/young-serif/400.css';
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/400-italic.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';

interface Props {
  title: string;
  description?: string;
}
const { title, description } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <script is:inline>
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {}
    </script>
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
  </head>
  <body>
    <header class="site">
      <nav>
        <a href="/">Chris Dabel</a>
        <a href="/cv/">CV</a>
        <button id="theme-toggle" type="button" hidden aria-pressed="false">Dark mode</button>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <script>
      const root = document.documentElement;
      const button = document.getElementById('theme-toggle') as HTMLButtonElement;
      const media = window.matchMedia('(prefers-color-scheme: dark)');

      const current = (): 'light' | 'dark' =>
        root.dataset.theme === 'dark' || (!root.dataset.theme && media.matches) ? 'dark' : 'light';

      const label = () => {
        const dark = current() === 'dark';
        button.textContent = dark ? 'Light mode' : 'Dark mode';
        button.setAttribute('aria-pressed', String(dark));
      };

      button.addEventListener('click', () => {
        const next = current() === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try { localStorage.setItem('theme', next); } catch {}
        label();
      });

      media.addEventListener('change', label);
      label();
      button.hidden = false;
    </script>
  </body>
</html>

<style is:global>
  :root {
    --bg: #f5f6f8;
    --fg: #1b2430;
    --muted: #5b6470;
    --rule: #d9dde3;
    --accent: #1f6f78;
    --display: 'Young Serif', Georgia, serif;
    --text: 'IBM Plex Sans', system-ui, sans-serif;
    --measure: 40rem;
    color-scheme: light;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) {
      --bg: #15191f;
      --fg: #e6e8eb;
      --muted: #98a1ab;
      --rule: #2a3038;
      --accent: #7fcbd1;
      color-scheme: dark;
    }
  }
  :root[data-theme='dark'] {
    --bg: #15191f;
    --fg: #e6e8eb;
    --muted: #98a1ab;
    --rule: #2a3038;
    --accent: #7fcbd1;
    color-scheme: dark;
  }

  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--fg);
    font-family: var(--text);
    font-size: 1.0625rem;
    line-height: 1.6;
    font-feature-settings: 'kern', 'liga';
  }

  header.site, main {
    max-width: var(--measure);
    margin: 0 auto;
    padding: 0 1.25rem;
  }
  header.site nav {
    display: flex;
    gap: 1.5rem;
    padding: 1.75rem 0 0;
    font-weight: 500;
    font-size: 0.95rem;
  }
  header.site nav a { color: var(--muted); text-decoration: none; }
  header.site nav a:hover { color: var(--fg); }
  #theme-toggle {
    margin-left: auto;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    color: var(--muted);
    cursor: pointer;
  }
  #theme-toggle:hover { color: var(--fg); }
  main { padding: 3.5rem 1.25rem 5rem; }

  h1 {
    font-family: var(--display);
    font-weight: 400;
    font-size: clamp(2.5rem, 1.5rem + 4vw, 3.75rem);
    line-height: 1.02;
    letter-spacing: -0.015em;
    margin: 0 0 1.25rem;
  }
  h2 {
    font-size: 1.125rem;
    font-weight: 600;
    margin: 3.5rem 0 1rem;
  }
  h3 { font-size: 1.125rem; font-weight: 600; margin: 0; }
  p { margin: 0 0 1.1rem; max-width: var(--measure); }

  a { color: var(--accent); text-decoration-thickness: 1px; text-underline-offset: 0.15em; }
  a:hover { text-decoration-thickness: 2px; }
  :focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; border-radius: 2px; }

  ::selection { background: var(--accent); color: var(--bg); }
</style>
