---
// Deliberately plain. Visual design is undecided; this layout only makes
// pages readable until that decision is made.
interface Props {
  title: string;
  description?: string;
}
const { title, description } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
  </head>
  <body>
    <header>
      <nav>
        <a href="/">Chris Dabel</a>
        <a href="/cv/">CV</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>

<style is:global>
  :root {
    --bg: #ffffff;
    --fg: #1a1a1a;
    --muted: #666666;
    --rule: #e4e4e4;
    color-scheme: light dark;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #121212;
      --fg: #e8e8e8;
      --muted: #9a9a9a;
      --rule: #2c2c2c;
    }
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--fg);
    font: 17px/1.55 system-ui, -apple-system, 'Segoe UI', sans-serif;
  }
  body > header, main { max-width: 42rem; margin: 0 auto; padding: 0 1rem; }
  nav { display: flex; gap: 1.5rem; padding: 1.5rem 0; }
  nav a { color: inherit; text-decoration: none; }
  nav a:hover { text-decoration: underline; }
  main { padding-bottom: 4rem; }
  h1 { font-size: 1.75rem; margin: 1rem 0 0.5rem; }
  h2 { font-size: 1.25rem; margin: 3rem 0 1rem; }
  p { margin: 0 0 1rem; }
  a { color: inherit; }
</style>
