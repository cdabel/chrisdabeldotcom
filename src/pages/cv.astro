---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { roles, education } from '../data/roles';

const entries = (await getCollection('cv')).sort((a, b) => a.data.order - b.data.order);
const rendered = await Promise.all(
  entries.map(async (entry) => ({ entry, Content: (await render(entry)).Content })),
);

// Accomplishments per role, in CV order. Shown on the timeline as links
// back to the entries above; roles with many show the first few.
const SHOWN = 3;
const byOrg = new Map<string, typeof entries>();
for (const e of entries) byOrg.set(e.data.org, [...(byOrg.get(e.data.org) ?? []), e]);
---

<Base title="CV | Chris Dabel" description="Data engineer and architect. What I have built and where.">
  <h1>CV</h1>
  <p class="lede">
    Data engineer and architect, twelve years in. The short version is below:
    what was built, and the one or two numbers that matter.
  </p>
  <p class="jump"><a href="#timeline">Jump to the timeline</a></p>

  <section aria-labelledby="work">
    <h2 id="work">What I have built</h2>
    <ol class="dragons">
      {rendered.map(({ entry, Content }) => (
        <li>
          <article id={entry.id}>
            <header>
              <h3>{entry.data.title}</h3>
              <p class="meta">{entry.data.org}, {entry.data.period}</p>
            </header>
            {entry.data.stats.length > 0 && (
              <dl class="stats">
                {entry.data.stats.map((s) => (
                  <div>
                    <dt>{s.label}</dt>
                    <dd>{s.value}</dd>
                  </div>
                ))}
              </dl>
            )}
            <Content />
          </article>
        </li>
      ))}
    </ol>
  </section>

  <section aria-labelledby="said">
    <h2 id="said">Said about the work</h2>
    <blockquote>
      <p>
        He joined Finally to help us stand up our Data and Data Governance
        programs, and delivered on that mandate within a tight timeline, in a
        highly regulated industry.
      </p>
      <footer>Ernesto Mancebo, engineering and AI platforms, Finally. October 2026.</footer>
    </blockquote>
  </section>

  <section aria-labelledby="timeline">
    <h2 id="timeline">Timeline</h2>
    <ol class="timeline">
      {roles.map((r) => {
        const own = byOrg.get(r.org) ?? [];
        return (
          <li>
            <p class="when">{r.period}</p>
            <p class="who"><span class="org">{r.org}</span><span class="title">{r.title}</span></p>
            {own.length > 0 ? (
              <ul class="slain">
                {own.slice(0, SHOWN).map((e) => (
                  <li><a href={`#${e.id}`}>{e.data.title}</a></li>
                ))}
                {own.length > SHOWN && (
                  <li class="more"><a href="#work">and {own.length - SHOWN} more above</a></li>
                )}
              </ul>
            ) : (
              r.note && <p class="note">{r.note}</p>
            )}
          </li>
        );
      })}
    </ol>
  </section>

  <section aria-labelledby="edu">
    <h2 id="edu">Education</h2>
    <ul class="roles">
      {education.map((e) => (
        <li>
          <span class="org">{e.school}</span>
          <span class="title">{e.degree}</span>
          <span class="period">{e.year}</span>
        </li>
      ))}
    </ul>
  </section>
</Base>

<style>
  .lede { font-size: 1.2rem; color: var(--muted); margin-bottom: 0; }
  .dragons { list-style: none; padding: 0; margin: 0; }
  .dragons > li { padding: 1.75rem 0; border-top: 1px solid var(--rule); }
  .dragons > li:first-child { border-top: 0; padding-top: 0.5rem; }
  .meta { color: var(--muted); font-size: 0.9rem; margin: 0.2rem 0 0.9rem; }
  .stats { display: flex; flex-wrap: wrap; gap: 0.5rem 2.5rem; margin: 0 0 1rem; }
  .stats div { display: flex; flex-direction: column-reverse; }
  .stats dt { color: var(--muted); font-size: 0.85rem; }
  .stats dd {
    margin: 0;
    font-family: var(--display);
    font-size: 1.9rem;
    line-height: 1.1;
    letter-spacing: -0.01em;
  }
  article :global(p:last-child) { margin-bottom: 0; }
  blockquote { margin: 0; padding-left: 1.1rem; border-left: 2px solid var(--accent); }
  blockquote p { font-size: 1.1rem; font-style: italic; }
  blockquote footer { color: var(--muted); font-size: 0.9rem; }
  .jump { margin: 0.75rem 0 0; font-size: 0.95rem; }
  article { scroll-margin-top: 1.5rem; }
  .timeline { list-style: none; padding: 0 0 0 1.25rem; margin: 0; border-left: 2px solid var(--rule); }
  .timeline > li { position: relative; padding: 0 0 1.75rem; }
  .timeline > li::before {
    content: '';
    position: absolute;
    left: calc(-1.25rem - 6px);
    top: 0.55rem;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--accent);
  }
  .timeline > li:last-child { padding-bottom: 0.25rem; }
  .when { color: var(--muted); font-size: 0.9rem; margin: 0 0 0.15rem; }
  .who { margin: 0 0 0.4rem; }
  .who .org { font-weight: 600; }
  .who .title { color: var(--muted); }
  .who .title::before { content: ', '; }
  .slain { list-style: none; padding: 0; margin: 0; }
  .slain li { margin: 0.15rem 0; }
  .slain a { text-decoration: none; }
  .slain a:hover { text-decoration: underline; }
  .slain .more a { color: var(--muted); font-size: 0.9rem; }
  .note { color: var(--muted); margin: 0; max-width: 36rem; }
  .roles { list-style: none; padding: 0; margin: 0; }
  .roles li {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0 1rem;
    padding: 0.65rem 0;
    border-top: 1px solid var(--rule);
  }
  @media (min-width: 600px) {
    .roles li { grid-template-columns: 11rem 1fr auto; }
  }
  .roles .org { font-weight: 600; }
  .roles .period { color: var(--muted); font-size: 0.9rem; white-space: nowrap; }
</style>
